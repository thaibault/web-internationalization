# Normalize line endings: Detect text files automatically, store them with
# unix line endings in the repository and enforce unix line endings on checkout
# even on Windows or Mac environments (shell scripts break with "\r\n").
* text=auto eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Keep line endings untouched (e.g. vCards require CRLF by specification and
# are served as stored).
*.vcf -text

# Denote all files that are truly binary and should not be modified.
*.7z binary
*.eot binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.otf binary
*.pdf binary
*.png binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
