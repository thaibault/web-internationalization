{
  "name": "web-internationalization",
  "version": "2.0.61",
  "description": "Expand your audience",
  "keywords": [
    "lang",
    "language",
    "internationalization"
  ],
  "homepage": "https://tsickert.com/web-internationalization",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/web-internationalization/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/web-internationalization.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./bundle": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./bundle/compatible": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle/compatible/index.js"
    },
    "./compatible": {
      "types": "./dist/index.d.ts",
      "default": "./dist/compatible/index.js"
    },
    "./type": {
      "types": "./dist/type.d.ts"
    }
  },
  "main": "dist/index.js",
  "typesVersions": {
    "*": {
      "type": [
        "./dist/type.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/test.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types && yarn build:plain && yarn build:compatible && yarn build:bundle && yarn build:bundle:compatible",
    "build:bundle": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:bundle:compatible": "weboptimizer build '{__reference__: [\"target:bundle\", \"target:compatible\", \"target:bundle:compatible\"]}'",
    "build:compatible": "weboptimizer build '{__reference__: \"target:compatible\"}'",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "weboptimizer test",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.10",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@webcomponents/webcomponentsjs": "^2.8.1",
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.5",
    "favicons-webpack-plugin": "^6.0.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "prop-types": "^15.8.1",
    "typescript-eslint": "^8.74.0",
    "web-component-wrapper": "^0.0.625",
    "web-documentation": "^1.0.77",
    "weboptimizer": "^4.0.125",
    "webpack-dev-server": "^6.1.0"
  },
  "peerDependencies": {
    "clientnode": "*",
    "core-js": "*",
    "web-component-wrapper": "*"
  },
  "peerDependenciesMeta": {
    "clientnode": {
      "optional": true
    },
    "web-component-wrapper": {
      "optional": true
    }
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "Expand your audience<!--deDE:Erweitern Sie Ihr Publikum--><!--frFR:Élargir votre audience-->"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "generic": {
      "supportedBrowsers": [
        "browserslist config and supports es6-class"
      ]
    },
    "module": {
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "htmlMinifier": {
          "ignoreCustomComments": [
            {
              "__evaluate__": "/^\\|?[a-z]{2}[A-Z]{2}:/"
            },
            {
              "__evaluate__": "/^[a-z]{2}[A-Z]{2}$/"
            }
          ]
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "target:bundle:compatible": {
      "path": {
        "target": {
          "base": "dist/bundle/compatible/"
        }
      }
    },
    "target:compatible": {
      "generic": {
        "supportedBrowsers": [
          "IE >= 11",
          "last 2 versions",
          "> 5%"
        ]
      },
      "path": {
        "target": {
          "base": "dist/compatible/"
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
