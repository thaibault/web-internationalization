{
  "name": "web-internationalization",
  "version": "2.0.58",
  "description": "Expand your audience",
  "keywords": [
    "lang",
    "language",
    "internationalization"
  ],
  "homepage": "https://tsickert.com/web-internationalization",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/web-internationalization/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/web-internationalization"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./compatible": "./dist/compatible/index.js",
    "./type": "./dist/type.js"
  },
  "main": "dist/index.js",
  "typesVersions": {
    "*": {
      "type": [
        "./dist/type.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types && yarn build:plain && yarn build:compatible && yarn build:bundle && yarn build:bundle:compatible",
    "build:bundle": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:bundle:compatible": "weboptimizer build '{__reference__: [\"target:bundle\", \"target:compatible\", \"target:bundle:compatible\"]}'",
    "build:compatible": "weboptimizer build '{__reference__: \"target:compatible\"}'",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "yarn clear && weboptimizer test",
    "test:browser": "yarn clear && weboptimizer test:browser",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier": "^4.0.6",
    "@types/imagemin": "^9.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "clientnode": "^4.0.1524",
    "eslint": "^10.13.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "favicons-webpack-plugin": "^6.0.1",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "prop-types": "^15.8.1",
    "typescript-eslint": "^8.72.0",
    "web-component-wrapper": "^0.0.619",
    "web-documentation": "^1.0.64",
    "weboptimizer": "^4.0.91",
    "webpack-dev-server": "^6.1.0"
  },
  "peerDependencies": {
    "clientnode": "*",
    "prop-types": "^15.8.1",
    "web-component-wrapper": "*"
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "deDE",
      "enUS",
      "frFR"
    ],
    "tagline": "Expand your audience<!--deDE:Erweitern Sie Ihr Publikum--><!--frFR:Élargir votre audience-->",
    "trackingCode": "UA-40192634-6"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "generic": {
      "supportedBrowsers": [
        "browserslist config and supports es6-class"
      ]
    },
    "module": {
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "htmlMinifier": {
          "ignoreCustomComments": [
            {
              "__evaluate__": "/^\\|?[a-z]{2}[A-Z]{2}:/"
            },
            {
              "__evaluate__": "/^[a-z]{2}[A-Z]{2}$/"
            }
          ]
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "target:bundle:compatible": {
      "path": {
        "target": {
          "base": "dist/bundle/compatible/"
        }
      }
    },
    "target:compatible": {
      "generic": {
        "supportedBrowsers": [
          "IE >= 11",
          "last 2 versions",
          "> 5%"
        ]
      },
      "path": {
        "target": {
          "base": "dist/compatible/"
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
